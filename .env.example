# Server settings
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Optional shared secret for Web UI & API (leave empty if behind Tailscale/LAN)
WEB_AUTH_TOKEN=

# Max direct Web upload size in MB (20480 = 20 GB)
MAX_UPLOAD_MB=20480
# Max size per Telegram message part in MB (~1.9 GiB ceiling for multi-part splitting)
TELEGRAM_PART_SIZE_MB=1900

# Local data & staging directories
DATA_DIR=./data
STAGING_DIR=./data/staging

# Storage mode:
#   "telegram" = forward to Telegram Forum Topic & delete local staged copy (thumbnails + index stay local)
#   "drives"   = save only to mounted drives / local disk in DRIVES_JSON
#   "both"     = mirror to Telegram Topic AND keep a copy in DRIVES_JSON
STORAGE_MODE=telegram

# Drive/folder list used when STORAGE_MODE is "drives" or "both"
DRIVES_JSON=[{"name": "local", "path": "/home/ubuntu/media-vault"}]

# Allocation strategy: "first_fit" or "most_free"
ALLOCATION_STRATEGY=first_fit
MIN_FREE_BUFFER_MB=500
DEFAULT_FOLDER=General

# Telegram MTProto integration (using my.telegram.org api_id + api_hash for up to 2GB support)
# Supports 1 to 4+ entries in TELEGRAM_APIS_JSON.
# Each entry: {"name": "acc1", "api_id": 123456, "api_hash": "your_hash", "bot_token": "123:ABC"}
TELEGRAM_APIS_JSON=[]
# Comma-separated Telegram numeric user IDs allowed to send links/media to the bot(s)
ALLOWED_TELEGRAM_USER_IDS=
# Optional Private Supergroup ID (with Topics enabled) shared by your accounts & bots,
# e.g. -1001234567890. Each folder maps to a Topic in this supergroup.
TELEGRAM_ARCHIVE_CHAT_ID=
# Optional MTProto streaming & upload tuning
TELEGRAM_STREAM_CHUNK_KB=512
TELEGRAM_STREAM_CACHE_MB=64
TELEGRAM_UPLOAD_CONCURRENCY=4
# Optional L2 disk hot-block LRU cache in MB (0 = disabled, e.g. 512 or 2048 to enable persistent disk caching)
TELEGRAM_DISK_CACHE_MB=0
# Optional L2 disk cache directory (defaults to <DATA_DIR>/stream_cache)
TELEGRAM_DISK_CACHE_DIR=
# Bounded sequential read-ahead blocks (0 disables prefetch)
TELEGRAM_PREFETCH_BLOCKS=2
# Global concurrent background prefetch cap
TELEGRAM_PREFETCH_MAX_CONCURRENCY=4
# Bounded L1 in-memory ZIP directory cache entries
ZIP_CACHE_MAX_ITEMS=256
# Max SQLite-persisted ZIP directory cache rows
ZIP_CACHE_DB_MAX_ROWS=500
# Max compressed SQLite ZIP directory cache size in MB
ZIP_CACHE_DB_MAX_MB=16

# Optional Netscape cookies.txt path & proxy for yt-dlp (fixes YouTube bot checks on cloud VMs)
YTDLP_COOKIES_FILE=./data/cookies.txt
YTDLP_PROXY=
YTDLP_CONCURRENT_FRAGMENTS=4

# Bounded concurrency limit for background ingest jobs
INGEST_CONCURRENCY=3

# Vault Backup & Integrity Maintenance settings
# Optional backup output directory (defaults to <DATA_DIR>/backups, i.e. ./data/backups)
BACKUP_DIR=
# Number of local .db.gz snapshots to retain after pruning
BACKUP_RETENTION_COUNT=10
# Automatic scheduled backup interval in hours (0 disables scheduled backups)
BACKUP_INTERVAL_HOURS=0
# Upload created .db.gz backups to the Telegram archive supergroup topic
BACKUP_TELEGRAM_ENABLED=false
BACKUP_TELEGRAM_TOPIC=_VaultBackups
# Grace period (seconds) before unreferenced staging files are flagged/purged as orphans
INTEGRITY_STAGING_GRACE_SEC=300
# Batch size and delay (seconds) when verifying Telegram messages during integrity audits
INTEGRITY_TELEGRAM_BATCH_SIZE=50
INTEGRITY_TELEGRAM_BATCH_DELAY_SEC=0.25

# Resumable Chunked Uploads & Failed-Upload Retention (Track #2)
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_MAX_CHUNK_SIZE_MB=32
UPLOAD_SESSION_TTL_SEC=86400
UPLOAD_MAX_STAGING_MB=0
UPLOAD_MAX_CONCURRENT_SESSIONS=50
FAILED_UPLOAD_RETENTION_SEC=3600
FAILED_UPLOAD_MAX_RETAINED_MB=4096
STAGING_GC_INTERVAL_SEC=300
